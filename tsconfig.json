{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
		"useDefineForClassFields": true,
		"noEmit": true,
		"strictNullChecks": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": [
		".wxt/types/**/*.d.ts",
		"src/env.d.ts",
		"src/entrypoints/background.ts",
		"src/entrypoints/content.ts",
		"src/entrypoints/sidepanel/**/*",
		"src/components/X*.tsx",
		"src/components/ui/**/*",
		"src/lib/cn.ts",
		"src/lib/llm-test.ts",
		"src/lib/product-catalog.ts",
		"src/lib/storage.ts",
		"src/lib/types.ts",
		"src/lib/x-reply-generator.ts",
		"src/lib/x-reply-generator.test.ts",
		"wxt.config.ts"
	]
}
